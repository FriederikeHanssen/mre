manifest {
    name            = 'optional-params'
    author          = 'Friederike Hanssen'
    description     = 'Optional/nullable typed parameters with nf-schema (26.04)'
    nextflowVersion = '!>=26.04.0'
    version         = '1.0.0'
}

// nf-schema provides validateParameters() / paramsSummaryLog().
// >=2.7.2 casts CLI params to their declared types under the v2 parser.
plugins {
    id 'nf-schema@2.7.2'
}

// Where the output block publishes.
outputDir = 'results'