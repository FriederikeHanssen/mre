manifest {
    name            = 'sendmail-task-notification'
    author          = 'Friederike Hanssen'
    description     = 'Per-task email notifications with the built-in sendMail() function'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}

// SMTP settings for sendMail(). Values come from the environment so no
// credentials land in git:
//   export SMTP_HOST=smtp.gmail.com SMTP_PORT=587
//   export SMTP_USER=you@gmail.com  SMTP_PASSWORD=app-password
//
// If you leave these unset, Nextflow falls back to the local `sendmail`/`mail`
// command on the host (handy for a quick local test with a mail catcher).
mail {
    from = System.getenv('SMTP_USER') ?: 'nextflow@localhost'
    smtp {
        host     = System.getenv('SMTP_HOST')
        port     = (System.getenv('SMTP_PORT') ?: '587') as Integer
        user     = System.getenv('SMTP_USER')
        password = System.getenv('SMTP_PASSWORD')
    }
}
